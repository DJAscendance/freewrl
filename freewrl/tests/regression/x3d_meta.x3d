<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" "http://www.web3d.org/specifications/x3d-3.3.dtd">
<X3D profile='Interchange' version='3.3'>
  <head>
    <meta name='description' content='Regression: head meta tags. FreeWRL 6.7 read the content attribute under the wrong name and crashed (strdup of NULL) on any meta tag. Pass: no crash, a green box renders.'/>
    <meta name='only-a-name'/>
    <meta content='only content'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 5' description='front'/>
    <Shape><Appearance><Material diffuseColor='0 1 0'/></Appearance><Box size='1.5 1.5 1.5'/></Shape>
  </Scene>
</X3D>
