#VRML V2.0 utf8
# Image formats the macOS build does NOT decode (stb_image has no TIFF or WebP decoder).
# Left: TIFF, right: WebP.
# Expected on macOS: two untextured boxes, one "failed to load image" line per file, no crash.
# Other platforms (Imlib2 with its TIFF and WebP loaders) show both images.
Viewpoint { position 0 0 7 description "front" }
NavigationInfo { headlight TRUE }
Transform { translation -1.2 0 0 rotation 1 1 0 0.5 children Shape {
	appearance Appearance { material Material { } texture ImageTexture { url "images/sand.tiff" } }
	geometry Box { size 1.4 1.4 1.4 } } }
Transform { translation 1.2 0 0 rotation 1 1 0 0.5 children Shape {
	appearance Appearance { material Material { } texture ImageTexture { url "images/mountns.webp" } }
	geometry Box { size 1.4 1.4 1.4 } } }
