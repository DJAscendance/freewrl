@FW_DEBUG_FALSE@DEBUG_FLAGS = -O2

# Debug options
@FW_DEBUG_TRUE@DEBUG_FLAGS = -g -O0

# Compiler warnings: 
# http://gcc.gnu.org/onlinedocs/gcc-4.3.2/gcc/Preprocessor-Options.html#Preprocessor-Options

#CC_WARNINGS=-Wall -Wundef -Wunused-macros
#CCP_GENERAL=-fpermissive
# Compiler options / general flags
#c++ in world_script/*_sm.cpp needs permissive
CXX_SPECIFIC = -fpermissive
# NOT NEEDED ANYMORE : WE SETUP -D_GNU_SOURCE ON LINUX 
#
# # Needed by ipc.h => error: #warning "Files using this header must be compiled with _SVID_SOURCE or _XOPEN_SOURCE"
# # If we use _XOPEN_SOURCE then we must define also _BSD_SOURCE to have Motif compile...
# # CC_GENERAL=-D_XOPEN_SOURCE=500 -D_BSD_SOURCE
#
# WARNING: THIS IS MAYBE NEEDED ON MAC OR WINDOWS...

# Linker options

#
#LD_OPTS=-Wl,--as-needed

# Define this globally

# Get global variables for Makefile defined by toplevel Makefile.globals

# Just add variables tested and checked by toplevel configure

# General libraries used with all platforms
AM_CPPFLAGS = $(CC_WARNINGS) $(CC_GENERAL) $(PLUGIN_CFLAGS) \
	$(am__append_3) -DBUILD_TIMESTAMP=\"$(BUILD_TIMESTAMP)\"
AM_CFLAGS = $(DEBUG_FLAGS) $(am__append_1) $(am__append_2)
AM_CXXFLAGS = $(AM_CFLAGS) $(CXX_SPECIFIC)
AM_LDFLAGS = $(DEBUG_FLAGS) $(LD_OPTS)
EXTERNAL_LIBS = \
				$(PLUGIN_LIBS)


# X11 flags specific to x11 target (default on Linux -- optional on Mac)
@WINDOW_USE_AQUA_TRUE@ERR = Error: Build system does not currently support Mac Safari Target
_EV = $(top_srcdir)/versions/PLUGIN
templ = $(top_srcdir)/versions/template/version.c.in
component = freewrl_plugin
PLUGIN_VERSION = `cat $$_EV`
BUILD_TIMESTAMP = `date +%F_%T`
# And add it to the list of files to clean
CLEANFILES = internal_version.c
LIBFREEWRL_SRCDIR = $(top_srcdir)/src/lib
LIBFREEWRL_BUILDDIR = $(top_builddir)/src/lib

# I'm removing external dependency from the plugin
# not needed: AM_CPPFLAGS += -I$(LIBFREEWRL_SRCDIR)

# libtool does not help much here, I'll end using gcc -shared
# if we don't find a smart way to instruct libtool...
plugin_LTLIBRARIES = libFreeWRLplugin.la
libFreeWRLplugin_la_LIBTOOLFLAGS = --tag=disable-static

# This makes the plugin installs in $libdir/mozilla/plugins by default...
plugindir = $(PLUGIN_DIR)
libFreeWRLplugin_la_LDFLAGS = -no-undefined -module -avoid-version $(AM_LDFLAGS)
DIST_sources = \
			plugin_main.c \
			npunix.c \
			system.h \
			plugin_utils.h

# Im' removing external dependency from the plugin
# not needed: libFreeWRLplugin_la_LIBADD = $(LIBFREEWRL_BUILDDIR)/libFreeWRL.la $(EXTERNAL_LIBS)
# this last variable would be set with required libs for mozilla
EXTRA_DIST = $(DIST_sources)
SOURCES_common = plugin_main.c \
		system.h \
		plugin_utils.h

libFreeWRLplugin_la_SOURCES = $(SOURCES_common) $(am__append_4) \
	$(am__append_5) internal_version.c
all: all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(top_srcdir)/Makefile.globals $(srcdir)/Makefile.sources $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu src/plugin/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu src/plugin/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/Makefile.globals $(srcdir)/Makefile.sources $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

install-pluginLTLIBRARIES: $(plugin_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(plugin_LTLIBRARIES)'; test -n "$(plugindir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(plugindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(plugindir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(plugindir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(plugindir)"; \
	}

uninstall-pluginLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(plugin_LTLIBRARIES)'; test -n "$(plugindir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(plugindir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(plugindir)/$$f"; \
	done

clean-pluginLTLIBRARIES:
	-test -z "$(plugin_LTLIBRARIES)" || rm -f $(plugin_LTLIBRARIES)
	@list='$(plugin_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

libFreeWRLplugin.la: $(libFreeWRLplugin_la_OBJECTS) $(libFreeWRLplugin_la_DEPENDENCIES) $(EXTRA_libFreeWRLplugin_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libFreeWRLplugin_la_LINK) -rpath $(plugindir) $(libFreeWRLplugin_la_OBJECTS) $(libFreeWRLplugin_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

