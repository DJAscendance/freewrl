@FW_DEBUG_FALSE@DEBUG_FLAGS = -O2

# Debug options
@FW_DEBUG_TRUE@DEBUG_FLAGS = -g -O0

# Compiler warnings: 
# http://gcc.gnu.org/onlinedocs/gcc-4.3.2/gcc/Preprocessor-Options.html#Preprocessor-Options

#CC_WARNINGS=-Wall -Wundef -Wunused-macros
#CCP_GENERAL=-fpermissive
# Compiler options / general flags
#c++ in world_script/*_sm.cpp needs permissive
CXX_SPECIFIC = -fpermissive
# NOT NEEDED ANYMORE : WE SETUP -D_GNU_SOURCE ON LINUX 
#
# # Needed by ipc.h => error: #warning "Files using this header must be compiled with _SVID_SOURCE or _XOPEN_SOURCE"
# # If we use _XOPEN_SOURCE then we must define also _BSD_SOURCE to have Motif compile...
# # CC_GENERAL=-D_XOPEN_SOURCE=500 -D_BSD_SOURCE
#
# WARNING: THIS IS MAYBE NEEDED ON MAC OR WINDOWS...

# Linker options

#
#LD_OPTS=-Wl,--as-needed

# Define this globally

# Just add variables tested and checked by toplevel configure

# General libraries used with all platforms
AM_CPPFLAGS = $(CC_WARNINGS) $(CC_GENERAL) $(ZLIB_CFLAGS) \
	$(PTHREAD_CFLAGS) $(FREETYPE_CFLAGS) $(FONTCONFIG_CFLAGS) \
	$(EXPAT_CFLAGS) $(XML_CFLAGS) $(GL_CFLAGS) $(JPEG_CFLAGS) \
	$(PNG_CFLAGS) $(LIBCURL_CFLAGS) $(IMLIB2_CFLAGS) $(ODE_CFLAGS) \
	$(JAVASCRIPT_ENGINE_CFLAGS) $(am__append_3) $(am__append_5) \
	$(am__append_7) $(am__append_11) $(am__append_13) \
	$(am__append_15) $(am__append_17)

# Get global variables for Makefile defined by toplevel Makefile.globals

# Compiler options
# freewrl library code uses a lot of type-punned pointers; turning off strict-aliasing
# (this enable -O2 compile to work)
AM_CFLAGS = $(DEBUG_FLAGS) $(am__append_1) $(am__append_2) \
	-fno-strict-aliasing
AM_CXXFLAGS = $(AM_CFLAGS) $(CXX_SPECIFIC)
AM_LDFLAGS = $(DEBUG_FLAGS) $(LD_OPTS)
EXTERNAL_LIBS = $(ZLIB_LIBS) $(PTHREAD_LIBS) $(FREETYPE_LIBS) \
	$(FONTCONFIG_LIBS) $(JAVASCRIPT_ENGINE_LIBS) $(EXPAT_LIBS) \
	$(XML_LIBS) $(GL_LIBS) $(JPEG_LIBS) $(PNG_LIBS) \
	$(LIBCURL_LIBS) $(IMLIB2_LIBS) $(LIBLO_LIBS) $(ODE_LIBS) \
	$(LIBM) $(am__append_4) $(am__append_6)
_EV = $(top_srcdir)/versions/LIBFREEWRL
_EV2 = $(top_srcdir)/versions/LIBFREEWRL_LTVERSION
templ = $(top_srcdir)/versions/template/version.c.in
component = libFreeWRL
LIBFREEWRL_VERSION = `cat $$_EV`
LIBFREEWRL_LTVERSION = `cat $$_EV2`
# And add it to the list of files to clean
CLEANFILES = internal_version.c

# To be able to check for libFreeWRL with pkg-config
pkgconfigdir = $(libdir)/pkgconfig
pkgconfig_DATA = libFreeWRL.pc
lib_LTLIBRARIES = libFreeWRL.la
include_HEADERS = libFreeWRL.h
libFreeWRL_la_LDFLAGS = -version-info $(LIBFREEWRL_LTVERSION) \
	$(AM_LDFLAGS) $(am__append_8)
libFreeWRL_la_LIBADD = $(EXTERNAL_LIBS)
